#!/bin/sh
# wifi <ssid> <passphrase> - same trick: install wpa_supplicant, start it, remove the package
# (the daemon keeps running from memory). Needs a wlan interface + driver in the kernel.
[ -n "$2" ] || { echo "usage: wifi <ssid> <passphrase>"; exit 2; }
ifc=$(ls /sys/class/net | grep -m1 '^wl') || { echo "no wlan interface"; exit 1; }
/usr/lib/quark/install wpa_supplicant || exit 1
wpa_passphrase "$1" "$2" > /tmp/wpa.conf
wpa_supplicant -B -i "$ifc" -c /tmp/wpa.conf && udhcpc -i "$ifc" -q -n -s /usr/lib/quark/udhcpc.script
/usr/lib/quark/remove wpa_supplicant
